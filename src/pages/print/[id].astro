---
// 교안 PDF를 만들기 위한 인쇄용 페이지입니다.
// 배포할 때 PDF로 바꾼 뒤 이 페이지는 지워지므로 사이트에는 남지 않습니다.
import '../../styles/global.css';
import { getCollection, getEntries, render } from 'astro:content';
import QRCode from 'qrcode';
import { SITE, INSTRUCTOR } from '../../site.config';
import { url, isExternal, formatDate } from '../../lib/url';
import { lessonStats } from '../../lib/lesson';

export async function getStaticPaths() {
  const lessons = await getCollection('lessons', ({ data }) => !data.draft);
  return lessons.map((lesson) => ({ params: { id: lesson.id }, props: { lesson } }));
}

const { lesson } = Astro.props;
const { Content, headings } = await render(lesson);
const sites = await getEntries(lesson.data.sites);
const toc = headings.filter((h) => h.depth === 2);
const stats = lessonStats(lesson.body ?? '', lesson.data.materials.length);
const abs = (p: string) => decodeURI(isExternal(p) ? p : Astro.site ? new URL(url(p), Astro.site).href : url(p));
const onlineUrl = abs(`/lessons/${lesson.id}/`);
const qrSvg = await QRCode.toString(onlineUrl, { type: 'svg', margin: 0, color: { dark: '#245647', light: '#ffffff' } });
const instructor = `${INSTRUCTOR.affiliation} ${INSTRUCTOR.role} ${INSTRUCTOR.name}`.trim();
---
<!doctype html>
<html lang="ko" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>{lesson.data.title}</title>
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
    <style is:global>
      @page { size: A4; margin: 15mm 14mm 17mm; }
      html, body { background: #fff; }
      body { font-size: 10.5pt; line-height: 1.65; }
      .pdf-cover {
        height: 262mm; display: flex; flex-direction: column; break-after: page;
        border-radius: 8mm; padding: 14mm 12mm 10mm;
        background: linear-gradient(160deg, #e3f0eb 0%, #ffffff 55%);
        border: 1px solid #d8e6e0;
      }
      .pdf-brand { font-weight: 800; color: #2f6f5e; font-size: 12pt; letter-spacing: 0.02em; }
      .pdf-cover h1 { font-size: 26pt; line-height: 1.3; margin: 6mm 0 3mm; color: #1f2421; }
      .pdf-summary { font-size: 12pt; color: #4a524c; margin: 0 0 6mm; }
      .pdf-cover-img { width: 100%; border-radius: 5mm; margin-bottom: 7mm; }
      .pdf-cover-bottom { margin-top: auto; display: flex; gap: 8mm; align-items: flex-end; }
      .pdf-info { border-collapse: collapse; flex: 1; font-size: 11pt; }
      .pdf-info th, .pdf-info td { text-align: left; padding: 2.4mm 3mm; border-bottom: 1px solid #d8e6e0; }
      .pdf-info th { width: 24mm; color: #2f6f5e; white-space: nowrap; }
      .pdf-qr { width: 34mm; text-align: center; font-size: 8.5pt; color: #5d655f; }
      .pdf-qr svg { width: 34mm; height: 34mm; display: block; margin-bottom: 1.5mm; }
      .pdf-stats { display: flex; gap: 3mm; margin-bottom: 6mm; }
      .pdf-stats span { border: 1px solid #d8e6e0; background: #fff; border-radius: 3mm; padding: 1.5mm 4mm; font-size: 10pt; color: #5d655f; }
      .pdf-stats b { color: #245647; font-size: 13pt; margin-right: 1mm; }

      .pdf-guide { break-after: page; }
      .pdf-guide h2 { font-size: 15pt; color: #245647; margin: 0 0 3mm; padding-bottom: 2mm; border-bottom: 2px solid #2f6f5e; }
      .pdf-guide section { margin-bottom: 6mm; }
      .pdf-guide ol, .pdf-guide ul { margin: 0; padding-left: 6mm; }
      .pdf-guide li { margin: 1mm 0; font-size: 10pt; }
      .pdf-toc { list-style: none; padding-left: 0 !important; }
      .pdf-toc li { font-size: 11pt; padding: 1.2mm 0; border-bottom: 1px dotted #d8e6e0; }
      .pdf-online { font-size: 9.5pt; color: #5d655f; }
      .pdf-guide .url { color: #2558a8; font-size: 9pt; word-break: break-all; }

      .prose { font-size: 10.5pt; }
      .prose h2 { break-after: avoid; font-size: 15pt; }
      .prose h3 { break-after: avoid; }
      .prose .prompt-card, .prose .callout, .prose img, .prose table, .prose .practice ol > li { break-inside: avoid; }
      .prose .prompt-actions { display: none; }
      .prose .practice, .prose .prompt-card { box-shadow: none; }
      .prose img { max-height: 120mm; width: auto; }
      .prose a { color: inherit; text-decoration: none; }
      /* 영상은 PDF에서 첫 그림(포스터)만 보이게 */
      .prose video { background: none; }
      .prose video::-webkit-media-controls, .prose video::-webkit-media-controls-enclosure { display: none !important; }
    </style>
  </head>
  <body>
    <section class="pdf-cover">
      <div class="pdf-brand">{SITE.title}</div>
      <h1>{lesson.data.title}</h1>
      {lesson.data.summary && <p class="pdf-summary">{lesson.data.summary}</p>}
      <div class="pdf-stats">
        {stats.practices > 0 && <span><b>{stats.practices}</b>실습</span>}
        {stats.prompts > 0 && <span><b>{stats.prompts}</b>프롬프트</span>}
        {stats.materials > 0 && <span><b>{stats.materials}</b>자료</span>}
        {sites.length > 0 && <span><b>{sites.length}</b>사이트</span>}
      </div>
      {lesson.data.cover && <img class="pdf-cover-img" src={url(lesson.data.cover)} alt="" />}
      <div class="pdf-cover-bottom">
        <table class="pdf-info">
          <tr><th>연수명</th><td>{lesson.data.title.split(' — ')[0]}</td></tr>
          <tr><th>일시</th><td>{formatDate(lesson.data.date)}</td></tr>
          <tr><th>대상</th><td>{lesson.data.audience}</td></tr>
          {lesson.data.duration && <tr><th>시간</th><td>{lesson.data.duration}</td></tr>}
          <tr><th>강사</th><td><strong>{instructor}</strong></td></tr>
        </table>
        <div class="pdf-qr"><Fragment set:html={qrSvg} />온라인 교안<br />(프롬프트 복사·자료)</div>
      </div>
    </section>

    <section class="pdf-guide">
      {toc.length > 0 && (
        <section>
          <h2>목차</h2>
          <ul class="pdf-toc">{toc.map((h) => <li>{h.text}</li>)}</ul>
        </section>
      )}
      {lesson.data.materials.length > 0 && (
        <section>
          <h2>실습 자료</h2>
          <ul>
            {lesson.data.materials.map((m) => (
              <li><strong>{m.title}</strong>{m.description && ` — ${m.description}`}<br /><span class="url">{abs(m.file)}</span></li>
            ))}
          </ul>
        </section>
      )}
      {sites.length > 0 && (
        <section>
          <h2>소개한 사이트</h2>
          <ul>{sites.map((s) => <li><strong>{s.data.name}</strong> — {s.data.description}<br /><span class="url">{s.data.url}</span></li>)}</ul>
        </section>
      )}
      <p class="pdf-online">예시 프롬프트 복사와 실습 자료 내려받기는 온라인 교안에서 할 수 있어요. <span class="url">{onlineUrl}</span></p>
    </section>

    <article class="prose">
      <Content />
    </article>
  </body>
</html>
