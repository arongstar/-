---
// 슬라이드 PDF를 만들기 위한 인쇄용 페이지입니다. (강사 소개 장 포함)
// 배포할 때 PDF로 바꾼 뒤 이 페이지는 지워지므로 사이트에는 남지 않습니다.
import Deck from '../../../components/slides/Deck.astro';
import { deckPaths, lessonQr } from '../../../lib/deck';

export const getStaticPaths = deckPaths;
const { deck, lesson } = Astro.props;
const { onlineUrl, qrSvg } = await lessonQr(Astro.site, lesson.id);
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>{lesson.data.title.split(' — ')[0]} — 발표 슬라이드</title>
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
    <style is:global>
      @page { size: 1280px 720px; margin: 0; }
      html, body { margin: 0; background: #fff; }
      .slide { break-after: page; }
      .slide:last-child { break-after: auto; }
    </style>
  </head>
  <body>
    <Deck deck={deck} lessonDate={lesson.data.date} mode="pdf" qrSvg={qrSvg} onlineUrl={onlineUrl} />
  </body>
</html>
